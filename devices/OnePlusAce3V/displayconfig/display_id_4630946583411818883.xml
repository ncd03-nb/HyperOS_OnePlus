    <refreshRate>
        <defaultRefreshRate>120</defaultRefreshRate>
        <defaultPeakRefreshRate>120</defaultPeakRefreshRate>
    </refreshRate>

    <ambientLightSensor>
        <type>android.sensor.light</type>
        <name>OPLUS Fusion Light Sensor</name>
        <refreshRateRange>
            <minimum>0</minimum>
            <maximum>120</maximum>
        </refreshRateRange>
    </ambientLightSensor>

    <highBrightnessMode enabled="true">
        <transitionPoint>0.85</transitionPoint>
        <minimumLux>10000</minimumLux>
        <timing>
            <timeWindowSecs>1800</timeWindowSecs>
            <timeMaxSecs>300</timeMaxSecs>
