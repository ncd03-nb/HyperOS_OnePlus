; System UID Java service. Keep shell unchanged and every domain enforcing.
(type ace3v_port)
(roletype object_r ace3v_port)
(typeattributeset domain (ace3v_port))
(typeattributeset coredomain (ace3v_port))
(typeattributeset appdomain (ace3v_port))
(type ace3v_port_exec)
(roletype object_r ace3v_port_exec)
(typeattributeset file_type (ace3v_port_exec))
(typeattributeset exec_type (ace3v_port_exec))
(typeattributeset system_file_type (ace3v_port_exec))
(allow init ace3v_port (process (transition)))
(typetransition init ace3v_port_exec process ace3v_port)
(allow ace3v_port ace3v_port_exec (file (read open getattr execute map entrypoint)))
(allow ace3v_port init (process (sigchld)))
(allow ace3v_port init (fd (use)))
(allow ace3v_port init (fifo_file (read write getattr)))
(allow ace3v_port system_server (binder (call transfer)))
(allow system_server ace3v_port (binder (call transfer)))
(allow ace3v_port system_app (binder (call transfer)))
(allow system_app ace3v_port (binder (call transfer)))
(allow ace3v_port system_app (fd (use)))
(allow ace3v_port activity_service (service_manager (find)))
(allow ace3v_port audio_service (service_manager (find)))
(allow ace3v_port proc_tristatekey (dir (read open getattr search)))
(allow ace3v_port proc_tristatekey (file (read open getattr)))
